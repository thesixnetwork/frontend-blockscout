# Production Frontend Configuration Template
# Copy this to your production server at: ~/blockscout/docker-compose/envs/common-frontend.env

# ===========================================
# APP CONFIGURATION
# ===========================================
NEXT_PUBLIC_APP_PROTOCOL=https
NEXT_PUBLIC_APP_HOST=your-production-domain.com
# Do not set NEXT_PUBLIC_APP_PORT for standard HTTPS (443) or HTTP (80) — omitting it avoids WalletConnect metadata URL mismatch
# NEXT_PUBLIC_APP_PORT=443
NEXT_PUBLIC_APP_ENV=production

# ===========================================
# API CONFIGURATION
# ===========================================
NEXT_PUBLIC_API_HOST=backend
NEXT_PUBLIC_API_PORT=4000
NEXT_PUBLIC_API_PROTOCOL=http
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=ws
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_API_SPEC_URL=https://raw.githubusercontent.com/blockscout/blockscout-api-v2-swagger/main/swagger.yaml

# ===========================================
# NETWORK CONFIGURATION
# ===========================================
NEXT_PUBLIC_NETWORK_NAME=SIX EVM Mainnet
NEXT_PUBLIC_NETWORK_SHORT_NAME=SIX EVM
NEXT_PUBLIC_NETWORK_ID=150
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=SIX
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=SIX
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_NETWORK_RPC_URL=https://rpc-evm.sixprotocol.net
NEXT_PUBLIC_IS_TESTNET=false

# ===========================================
# BRANDING
# ===========================================
NEXT_PUBLIC_NETWORK_LOGO=https://raw.githubusercontent.com/thesixnetwork/blockscout/six/main/apps/block_scout_web/assets/static/images/sixscan.png
NEXT_PUBLIC_NETWORK_LOGO_DARK=https://raw.githubusercontent.com/thesixnetwork/blockscout/six/main/apps/block_scout_web/assets/static/images/sixscan.png
NEXT_PUBLIC_NETWORK_ICON=https://raw.githubusercontent.com/chainapsis/keplr-chain-registry/main/images/sixnet/chain.png
NEXT_PUBLIC_NETWORK_ICON_DARK=https://raw.githubusercontent.com/chainapsis/keplr-chain-registry/main/images/sixnet/chain.png
NEXT_PUBLIC_OG_IMAGE_URL=https://raw.githubusercontent.com/thesixnetwork/blockscout/six/main/apps/block_scout_web/assets/static/images/sixscan.png
FAVICON_MASTER_URL=https://raw.githubusercontent.com/chainapsis/keplr-chain-registry/main/images/sixnet/chain.png

# ===========================================
# FEATURES
# ===========================================
NEXT_PUBLIC_USE_NEXT_JS_PROXY=false
NEXT_PUBLIC_IS_ACCOUNT_SUPPORTED=true
NEXT_PUBLIC_MARKETPLACE_ENABLED=false
NEXT_PUBLIC_OG_ENHANCED_DATA_ENABLED=true
NEXT_PUBLIC_HIDE_INDEXING_ALERT_BLOCKS=false
NEXT_PUBLIC_HIDE_INDEXING_ALERT_INT_TXS=false
NEXT_PUBLIC_TRANSACTION_INTERPRETATION_PROVIDER=blockscout

# ===========================================
# EXTERNAL SERVICES
# ===========================================
NEXT_PUBLIC_METADATA_SERVICE_API_HOST=https://metadata.services.blockscout.com
NEXT_PUBLIC_VISUALIZE_API_HOST=https://visualizer.services.blockscout.com

# ===========================================
# UI CONFIGURATION
# ===========================================
NEXT_PUBLIC_COLOR_THEME_DEFAULT=light
NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs']

# ===========================================
# ADS & ANALYTICS
# ===========================================
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_AD_TEXT_PROVIDER=none

# ===========================================
# INTEGRATIONS
# ===========================================
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=dd3af6cc7e6bcf40bcfd3d030722fe3c
NEXT_PUBLIC_RE_CAPTCHA_APP_SITE_KEY=6Le-hlIsAAAAAMy5-jGZ8VlCb_7Ka4YuCeOHYzO5

# ===========================================
# FOOTER & EXTERNAL LINKS
# ===========================================
NEXT_PUBLIC_FOOTER_LINKS=https://raw.githubusercontent.com/thesixnetwork/blockscout-frontend-configs/six/main/configs/footer-links/sixchain-evm.json
NEXT_PUBLIC_FEATURED_NETWORKS=https://raw.githubusercontent.com/thesixnetwork/blockscout-frontend-configs/six/main/configs/featured-networks/sixchain-mainnet.json

# ===========================================
# IDE INTEGRATIONS
# ===========================================
NEXT_PUBLIC_CONTRACT_CODE_IDES=[{'title':'Remix IDE','url':'https://remix.ethereum.org/?address={hash}&blockscout={domain}','icon_url':'https://raw.githubusercontent.com/blockscout/frontend-configs/main/configs/ide-icons/remix.png'}]

# ===========================================
# INSTANCE IDENTIFIER
# ===========================================
NEXT_PUBLIC_APP_INSTANCE=production

# ===========================================
# NODE ENVIRONMENT
# ===========================================
NODE_ENV=production
